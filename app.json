{
  "expo": {
    "name": "TaxonWorks App",
    "slug": "twig-mobile-base",
    "scheme": "twig-base",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.taxonworks.base",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera is used to scan the QR code shown by TaxonWorks."
      }
    },
    "android": {
      "package": "org.taxonworks.base",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-image",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "armeabi-v7a"]
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-font"
    ]
  }
}
